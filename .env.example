# "anthropic" (default) or "groq"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional -- overrides the provider's default model
AGENT_MODEL=

# Optional -- DEBUG shows every tool call's full args/results; INFO (default)
# shows the high-level decision trail without that noise.
LOG_LEVEL=INFO

# Optional -- seconds to pause before each LLM call in eval/run_eval.py.
# 0 (default) is a no-op; raise this if you hit rate limits (e.g. Groq's
# lower tiers enforce tight per-minute request/token limits).
EVAL_CALL_DELAY_SECONDS=0

# Optional -- where streamlit_app.py finds the FastAPI backend (api.py).
API_BASE_URL=http://127.0.0.1:8000
